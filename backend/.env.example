# ===== FoodScan AI Backend Environment Variables =====
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file to Git.

# --- Server ---
PORT=5001
NODE_ENV=development

# --- Database (PostgreSQL) ---
# Production (Render / Railway / Neon / Supabase):
DATABASE_URL="postgresql://user:password@host:5432/foodscan?schema=public"
# Local PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foodscan?schema=public"

# --- Security (MANDATORY in production) ---
# Generate a strong 64-char random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- 3rd Party APIs ---
# Google Gemini API key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# --- CORS ---
# Comma-separated list of origins to allow in production.
# Mobile frontend (Vercel / Netlify / custom domain) + any web dashboard URLs.
# Example: CORS_ALLOW_ORIGINS="https://foodscan.ai,https://app.foodscan.ai"
CORS_ALLOW_ORIGINS=
